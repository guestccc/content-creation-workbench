desktop/*.dmg
desktop/*.AppImage

npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================================================
# CLI（cw 开发服务管理工具）
# ==========================================================================
cli/.venv/

# cw 的运行时数据：pidfile 与日志，不应提交
.cw/

# ==========================================================================
# vct（视频内容制作工具箱，随仓库维护）
# ==========================================================================
# vct 的运行时数据：日志与本地配置，不应提交
.vct/

# ==========================================================================
# materials/（素材目录：原始视频与切分产物）
# ==========================================================================
# 里面的东西一律不入库：原片动辄几百 MB 到几 GB，切分产物更是成倍增长，
# 提交上去会让仓库没法用。切分产物落在 materials/clips/<视频名>_scenes/，
# 同样被挡住。
#
# 但目录骨架与说明要留在仓库里：README.md 讲清楚每一段放什么，
# 各分段（source / clips / subtitle / output / crawl）各带一个 .gitkeep 占位 ——
# git 不跟踪空目录，没有占位文件新克隆下来就只剩一个空文件夹。
# 后端启动时也会按 app/core/materials.py 的规划补建，两边互为兜底。
#
# 写法：先挡住 materials/ 下的一切，再逐个放行目录、说明与占位文件。
# gitignore 是后面的规则优先，顺序不能调换。
materials/**
!materials/README.md
!materials/source/
!materials/source/.gitkeep
!materials/clips/
!materials/clips/.gitkeep
!materials/subtitle/
!materials/subtitle/.gitkeep
!materials/output/
!materials/output/.gitkeep
!materials/crawl/
!materials/crawl/.gitkeep

# ==========================================================================
# doubao/（豆包素材目录：图片 / 视频 / 规范文档）
# ==========================================================================
# 与 materials/ 同一套约定：资源不入库（图片、视频体积大），只留目录骨架、
# README.md 说明与各子目录的 .gitkeep 占位。详见 doubao/README.md。
doubao/**
!doubao/README.md
!doubao/images/
!doubao/images/.gitkeep
!doubao/videos/
!doubao/videos/.gitkeep
!doubao/specs/
!doubao/specs/.gitkeep
