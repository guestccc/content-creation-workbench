# 环境变量样例文件
# 使用方法：复制为 .env 后按需修改。.env 已被 .gitignore 忽略，不会提交到仓库。

# ---------- 应用信息 ----------
APP_NAME=内容创作工作台
APP_VERSION=0.1.0
DEBUG=true

# ---------- 服务监听 ----------
# ⚠️ 保持 127.0.0.1：/api/v1/fs/list 是无鉴权的目录列举接口，
# 改成 0.0.0.0 暴露到局域网之前，必须先给它加鉴权或恢复根目录白名单。
HOST=127.0.0.1
PORT=8000

# ---------- 数据库 ----------
# 默认使用 SQLite，文件位于 backend 目录下
DATABASE_URL=sqlite:///./workbench.db
# 设为 true 可在控制台打印所有 SQL，排查问题时使用
DB_ECHO=false

# ---------- 跨域白名单 ----------
# 支持逗号分隔，需与前端开发服务器地址一致
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- 智能镜头分割 ----------
# vct 命令行工具路径，默认自动指向本仓库根目录的 vct（随仓库一起维护），一般无需配置
# SCENE_VCT_PATH=/absolute/path/to/vct
# 素材目录根，默认仓库根目录的 materials/。按流程分四段，各自的用途如下：
#   source/    原始素材：待切的视频往这里拷（镜头分割页的默认输入目录）
#   clips/     镜头分割产物：每条原片一个 <视频名>_scenes/ 子目录（默认输出目录）
#   subtitle/  字幕与文案产物（.srt / .txt）
#   output/    成片，待发布
# 半成品与成片都不入库（见根目录 .gitignore），但四个分段的目录骨架在仓库里。
# 目录不存在时后端启动会自动补建；指向别处也可以（支持 ~ 开头）。
# SCENE_MATERIALS_DIR=/absolute/path/to/materials
# 是否启用后台工作线程（测试时可关闭）
SCENE_WORKER_ENABLED=true
# 工作线程空闲轮询间隔（秒）
SCENE_JOB_POLL_SECONDS=1.0
# 单视频硬超时（秒），超时整组终止，防止卡住的任务堵死队列
SCENE_JOB_VIDEO_TIMEOUT_SECONDS=3600
# 可处理的视频扩展名，逗号分隔
SCENE_INPUT_EXTENSIONS=.mp4,.mov,.mkv,.avi,.webm,.m4v
# 单个任务最多处理的视频数
SCENE_MAX_BATCH_FILES=200

# ---------- 视频字幕提取（VideoCaptioner） ----------
# VideoCaptioner 不在本仓库里，默认自动探测工具箱目录下的 VideoCaptioner/.venv，
# 还会模糊匹配同级的 VideoCaptioner* 目录（从 GitHub 下载解压出来的常带
# -master 之类后缀），都找不到再试后端自己的解释器与 PATH。
# 装了别的位置时显式指定：
# SUBTITLE_VC_ROOT=/absolute/path/to/VideoCaptioner
# 也可以在「字幕提取」页面上点「手动指定 VideoCaptioner 目录」，
# 后端会把选定的路径自动写回本文件的这一项（写入时会保留注释与换行风格）。
# 显式指定装了 videocaptioner 的解释器（或它的可执行脚本），优先级最高：
# SUBTITLE_VC_PYTHON=/absolute/path/to/python
# 是否启用后台转写工作线程（测试时可关闭）
SUBTITLE_WORKER_ENABLED=true
# 单视频转写硬超时（秒），超时整组终止，防止卡住的任务堵死队列
SUBTITLE_JOB_VIDEO_TIMEOUT_SECONDS=1800
# 探测结果的缓存时长（秒）；页面上的「重新检测」按钮会绕过缓存
SUBTITLE_DETECT_CACHE_SECONDS=30
