# 环境变量样例文件
# 使用方法：复制为 .env 后按需修改。.env 已被 .gitignore 忽略，不会提交到仓库。

# ---------- 应用信息 ----------
APP_NAME=内容创作工作台
APP_VERSION=0.1.0
DEBUG=true

# ---------- 服务监听 ----------
# ⚠️ 保持 127.0.0.1：/api/v1/fs/list 是无鉴权的目录列举接口，
# 改成 0.0.0.0 暴露到局域网之前，必须先给它加鉴权或恢复根目录白名单。
HOST=127.0.0.1
PORT=8000

# ---------- 数据库 ----------
# 默认使用 SQLite，文件位于 backend 目录下
DATABASE_URL=sqlite:///./workbench.db
# 设为 true 可在控制台打印所有 SQL，排查问题时使用
DB_ECHO=false

# ---------- 跨域白名单 ----------
# 支持逗号分隔，需与前端开发服务器地址一致
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- 智能镜头分割 ----------
# vct 命令行工具路径，默认自动指向本仓库根目录的 vct（随仓库一起维护），一般无需配置
# SCENE_VCT_PATH=/absolute/path/to/vct
# 是否启用后台工作线程（测试时可关闭）
SCENE_WORKER_ENABLED=true
# 工作线程空闲轮询间隔（秒）
SCENE_JOB_POLL_SECONDS=1.0
# 单视频硬超时（秒），超时整组终止，防止卡住的任务堵死队列
SCENE_JOB_VIDEO_TIMEOUT_SECONDS=3600
# 可处理的视频扩展名，逗号分隔
SCENE_INPUT_EXTENSIONS=.mp4,.mov,.mkv,.avi,.webm,.m4v
# 单个任务最多处理的视频数
SCENE_MAX_BATCH_FILES=200
