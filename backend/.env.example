# 环境变量样例文件
# 使用方法：复制为 .env 后按需修改。.env 已被 .gitignore 忽略，不会提交到仓库。

# ---------- 应用信息 ----------
APP_NAME=内容创作工作台
APP_VERSION=0.1.0
DEBUG=true

# ---------- 服务监听 ----------
HOST=127.0.0.1
PORT=8000

# ---------- 数据库 ----------
# 默认使用 SQLite，文件位于 backend 目录下
DATABASE_URL=sqlite:///./workbench.db
# 设为 true 可在控制台打印所有 SQL，排查问题时使用
DB_ECHO=false

# ---------- 跨域白名单 ----------
# 支持逗号分隔，需与前端开发服务器地址一致
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 日志 ----------
LOG_LEVEL=INFO
